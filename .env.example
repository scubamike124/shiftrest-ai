# RestPilot AI — environment variable reference (documentation only)
#
# This file lists the environment variables the app expects at runtime.
# Do NOT put real values here — Lovable Cloud manages secrets securely and
# injects them into server functions / server routes at runtime. This file
# exists only so contributors and self-hosters can see the full surface.
#
# To set a value: add / rotate it via Lovable Cloud project secrets (Cloud →
# Secrets) or, for self-hosted deployments, in your host's env manager.

# ── Lovable Cloud (Supabase) ────────────────────────────────────────────────
# Publishable — safe to expose in the client bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Server-only. Never expose to the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Lovable AI Gateway ──────────────────────────────────────────────────────
# Server-only. Powers /api/ai, /api/brief, and Companion intents.
LOVABLE_API_KEY=

# ── ElevenLabs TTS (Pilot voice) ────────────────────────────────────────────
ELEVENLABS_API_KEY=

# ── Simli avatar ────────────────────────────────────────────────────────────
SIMLI_API_KEY=

# ── Web Push (VAPID) ────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ── Wearable sync ───────────────────────────────────────────────────────────
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# ── Stripe billing ──────────────────────────────────────────────────────────
STRIPE_SANDBOX_API_KEY=
STRIPE_LIVE_API_KEY=
PAYMENTS_SANDBOX_WEBHOOK_SECRET=
PAYMENTS_LIVE_WEBHOOK_SECRET=
# Website (Stripe) checkout for NEW purchases. Build-time, public. Off unless
# exactly "true" (owner decision, Nov 15 2026: new subscriptions are sold
# through Apple In-App Purchase in the iPhone app). Existing Stripe
# subscribers keep the portal, renewals and webhook either way.
# REVENUE RISK: while this is off and the App Store app is not live, nobody can
# start a new paid subscription. To sell on the website again, set it to
# "true" in .env.production and Publish.
VITE_WEB_CHECKOUT_ENABLED=
# ── Apple In-App Purchase (RevenueCat) ── all off/unset by default ─────────
# See docs/restpilot-upgrade-2026-11/APPLE-IAP-SETUP.md. The app offers a
# purchase only when the key is set, the native plugin is present, IAP_ENABLED
# is "true", both RevenueCat secrets are set AND the pending store_entitlements
# migration has been applied.
# Public (build time, .env.production): RevenueCat Apple SDK key, appl_…
VITE_REVENUECAT_IOS_API_KEY=
# Server-only (Lovable Cloud → Secrets):
IAP_ENABLED=
IAP_HONOR_SANDBOX=
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_WEBHOOK_AUTHORIZATION=
# Optional: dedicated key for signing wearable OAuth state (defaults to a
# value derived from SUPABASE_SERVICE_ROLE_KEY).
OAUTH_STATE_SECRET=
