# Configure in Railway service variables. No real secret values belong in git.
# Public Supabase settings must be present at build time AND runtime.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_APP_URL=

# Direct OpenAI-compatible chat provider. Explicit model choice required.
AI_API_KEY=
AI_BASE_URL=
AI_CHAT_MODEL=
AI_FAST_MODEL=
# Separate audio provider; explicit models required.
AI_AUDIO_API_KEY=
AI_AUDIO_BASE_URL=
AI_TTS_MODEL=
AI_STT_MODEL=
# Optional task routing (docs/restpilot-upgrade-2026-11/AI-BENCHMARK.md). Unset = every
# task uses AI_CHAT_MODEL (memory extraction: AI_FAST_MODEL). AI_ROUTING=off rolls back.
AI_ROUTING=
AI_MODEL_COACH=
AI_MODEL_VOICE=
AI_MODEL_STRUCTURED=
AI_MODEL_BRIEF=
AI_MODEL_BACKGROUND=
AI_REASONING_VOICE=
AI_STREAM_USAGE=
# Optional Realtime overrides (unset = gpt-realtime / whisper-1).
AI_REALTIME_MODEL=
AI_REALTIME_TRANSCRIBE_MODEL=
# Optional OpenAI fallback (sets default OpenAI endpoints when present).
OPENAI_API_KEY=
OPENAI_REALTIME_API_KEY=
ELEVENLABS_API_KEY=
SIMLI_API_KEY=

# Private White Glove voice test: comma-separated authenticated Supabase UUIDs.
# Empty means no beta enrollment. Never use a wildcard or client-side flag.
# Voice uses existing sandbox trial accounting and limits, with no checkout.
PRIVATE_BETA_USER_IDS=
VITE_ENABLE_REALTIME_PILOT=0

# Direct Resend email; configure verified sender and signed webhook callbacks.
RESEND_API_KEY=
EMAIL_FROM=
SEND_EMAIL_HOOK_SECRET=
RESEND_WEBHOOK_SECRET=
EMAIL_PREVIEW_SECRET=

# Shared secret for scheduled jobs (x-cron-secret header). Required by
# /api/public/hooks/{notify,dispatch-alarms,ai-learn,subscription-lifecycle}
# and /api/public/wearables/cron; without it they always return 401.
CRON_SECRET=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
# Stripe checkout is disabled. No Stripe keys are required for this app build.

# Apple In-App Purchase via RevenueCat (docs/restpilot-upgrade-2026-11/SUBSCRIPTIONS.md).
# OFF by default. Do not turn on until the owner completes the App Store
# Connect and RevenueCat setup. VITE_* values are baked in at build time.
VITE_IAP_ENABLED=false
# Honor Apple SANDBOX purchases (App Review, TestFlight). Needed while a build
# is in App Review; otherwise every TestFlight tester gets free Premium.
IAP_HONOR_SANDBOX=false
# Public RevenueCat Apple SDK key (appl_...). Public by design; not a secret.
VITE_REVENUECAT_IOS_API_KEY=
# US storefront only: link from the app to website purchase/billing pages.
# Separate opt-in; never applies to other storefronts.
VITE_IAP_US_EXTERNAL_LINK=false
# Server side: webhook + restore sync + Apple rows in entitlement status.
IAP_ENABLED=false
# Secrets (Railway secure variables only): RevenueCat secret API key (sk_...),
# webhook HMAC signing secret, optional webhook Authorization header value.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_WEBHOOK_AUTHORIZATION=
