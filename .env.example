# Configure in Railway service variables. No real secret values belong in git.
# Public Supabase settings must be present at build time AND runtime.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_APP_URL=

# Direct OpenAI-compatible chat provider. Explicit model choice required.
AI_API_KEY=
AI_BASE_URL=
AI_CHAT_MODEL=
AI_FAST_MODEL=
# Separate audio provider; explicit models required.
AI_AUDIO_API_KEY=
AI_AUDIO_BASE_URL=
AI_TTS_MODEL=
AI_STT_MODEL=
# Optional OpenAI fallback (sets default OpenAI endpoints when present).
OPENAI_API_KEY=
OPENAI_REALTIME_API_KEY=
ELEVENLABS_API_KEY=
SIMLI_API_KEY=

# Private White Glove voice test: comma-separated authenticated Supabase UUIDs.
# Empty means no beta enrollment. Never use a wildcard or client-side flag.
# Voice uses existing sandbox trial accounting and limits, with no checkout.
PRIVATE_BETA_USER_IDS=
VITE_ENABLE_REALTIME_PILOT=0

# Direct Resend email; configure verified sender and signed webhook callbacks.
RESEND_API_KEY=
EMAIL_FROM=
SEND_EMAIL_HOOK_SECRET=
RESEND_WEBHOOK_SECRET=
EMAIL_PREVIEW_SECRET=

# Shared secret for scheduled jobs (x-cron-secret header). Required by
# /api/public/hooks/{notify,dispatch-alarms,ai-learn,subscription-lifecycle}
# and /api/public/wearables/cron; without it they always return 401.
CRON_SECRET=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
# Stripe checkout is disabled. No Stripe keys are required for this app build.
