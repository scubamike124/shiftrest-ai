# RestPilot AI — environment variable reference (documentation only)
#
# This file lists the environment variables the app expects at runtime.
# Do NOT put real values here — Lovable Cloud manages secrets securely and
# injects them into server functions / server routes at runtime. This file
# exists only so contributors and self-hosters can see the full surface.
#
# To set a value: add / rotate it via Lovable Cloud project secrets (Cloud →
# Secrets) or, for self-hosted deployments, in your host's env manager.

# ── Lovable Cloud (Supabase) ────────────────────────────────────────────────
# Publishable — safe to expose in the client bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Server-only. Never expose to the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Lovable AI Gateway ──────────────────────────────────────────────────────
# Server-only. Powers /api/ai, /api/brief, and Companion intents.
LOVABLE_API_KEY=

# ── ElevenLabs TTS (Pilot voice) ────────────────────────────────────────────
ELEVENLABS_API_KEY=

# ── Simli avatar ────────────────────────────────────────────────────────────
SIMLI_API_KEY=

# ── Web Push (VAPID) ────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ── Wearable sync ───────────────────────────────────────────────────────────
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# ── Stripe billing ──────────────────────────────────────────────────────────
STRIPE_SANDBOX_API_KEY=
STRIPE_LIVE_API_KEY=
PAYMENTS_SANDBOX_WEBHOOK_SECRET=
PAYMENTS_LIVE_WEBHOOK_SECRET=

# Realtime entitlement checks use the server's environment, never a browser-selected lane.
# Set to live for production or sandbox for isolated tests. If omitted, the
# server may derive this from VITE_PAYMENTS_CLIENT_TOKEN when available at runtime.
# Conflicting settings fail closed. Never put a Stripe secret in the VITE variable.
PAYMENTS_ENVIRONMENT=
VITE_PAYMENTS_CLIENT_TOKEN=
# Existing OpenAI Realtime integration (server-only).
OPENAI_REALTIME_API_KEY=
